{
  "manifest_version": 3,
  "name": "PhishLens — Real-Time Phishing Protection",
  "version": "0.2.0",
  "description": "AI-powered real-time phishing detection with explainable in-page warnings and DOM security highlights.",
  "permissions": ["tabs", "scripting", "activeTab", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishLens Threat Inspector"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
